      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete untagged <none>:<none> dangling images; images a container references are kept"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除无 tag 的 <none>:<none> 悬挂 image；已被容器引用的 image 保留"

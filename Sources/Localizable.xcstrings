      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty the BuildKit build cache; the next build rebuilds it and runs slower"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空 BuildKit 构建缓存；下次构建会重建，速度会变慢"

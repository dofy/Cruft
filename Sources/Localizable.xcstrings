    "clean.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File tasks move things to the Trash and record a restore point. Command tasks, emptying the Trash and Docker prune can’t be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件型任务会移到废纸篓并写入恢复历史；命令型任务、清空废纸篓和 Docker prune 无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案型任務會移到垃圾桶並寫入還原記錄；指令型任務、清空垃圾桶和 Docker prune 無法還原。"
          }
        }
      }
    },

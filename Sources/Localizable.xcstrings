{
  "sourceLanguage": "en",
  "strings": {
    "access.banner.checking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking file access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查文件访问权限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在檢查檔案取用權限"
          }
        }
      }
    },
    "access.banner.checking.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is read until the check finishes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查完成前不会读取任何清理目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查完成之前不會讀取任何目錄。"
          }
        }
      }
    },
    "access.banner.enable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启访问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟取用權限"
          }
        }
      }
    },
    "access.banner.off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File access isn’t on yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件访问尚未开启"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案取用還沒開啟"
          }
        }
      }
    },
    "access.banner.off.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cruft hasn’t scanned caches, logs, projects, downloads or the Trash."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cruft 尚未扫描缓存、日志、项目、下载或废纸篓。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cruft 還沒掃描快取、記錄、專案、下載或垃圾桶。"
          }
        }
      }
    },
    "access.sheet.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cruft has to read the development caches, logs, build products, downloads and Trash in your home folder to estimate what they take up and to run the cleanups you confirm. File contents are processed on this machine and never uploaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cruft 需要读取用户目录中的开发缓存、日志、项目产物、下载文件和废纸篓，才能估算空间并执行你确认的清理。文件内容只在本机处理，不会上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cruft 需要讀取個人資料夾裡的開發快取、記錄、專案產物、下載檔案和垃圾桶，才能估算空間並執行你確認過的清理。檔案內容只在本機處理，不會上傳。"
          }
        }
      }
    },
    "access.sheet.checking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在檢查…"
          }
        }
      }
    },
    "access.sheet.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without access, Cruft doesn’t scan anything."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未授权时，Cruft 不会扫描清理目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有授權時，Cruft 不會掃描任何目錄。"
          }
        }
      }
    },
    "access.sheet.recheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检查"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新檢查"
          }
        }
      }
    },
    "access.sheet.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Privacy & Security → Full Disk Access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开「隐私与安全性 → 完全磁盘访问」"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開「隱私權與安全性 → 完全取用磁碟」"
          }
        }
      }
    },
    "access.sheet.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add or switch on /Applications/Cruft.app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加或开启 /Applications/Cruft.app"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入或開啟 /Applications/Cruft.app"
          }
        }
      }
    },
    "access.sheet.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come back to Cruft; it re-checks by itself"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回 Cruft；应用会自动重新检查"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回到 Cruft；它會自己重新檢查"
          }
        }
      }
    },
    "access.sheet.steps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to grant it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权步骤"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "授權步驟"
          }
        }
      }
    },
    "access.sheet.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS manages this, and you can turn it off in System Settings at any time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 macOS 管理，可随时在系统设置中关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由 macOS 管理，隨時可以在「系統設定」中關掉"
          }
        }
      }
    },
    "access.sheet.title.off": {
      "extractionState": "manual",
      "localizations": {
